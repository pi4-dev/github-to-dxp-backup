GH_ACCOUNT=your-github-user-or-organization
GH_ORGANIZATION=false
BACKUP_HOST_PATH=/absolute/path/to/backup/storage
TZ=UTC
BACKUP_INTERVAL=21600
FULL_INTERVAL=604800

# Optional success-only HTTP GET notification after a successful backup.
# Leave empty to disable.
KEEPALIVE_URL=
KEEPALIVE_TIMEOUT=10

# Backup integrity verification interval in seconds.
# Default: 604800 = 7 days.
# Set to 0 to verify after every successful backup.
VERIFY_INTERVAL=604800

# Optional success-only HTTP GET notification after ALL verification checks pass.
# Leave empty to disable.
VERIFY_KEEPALIVE_URL=
VERIFY_KEEPALIVE_TIMEOUT=10
